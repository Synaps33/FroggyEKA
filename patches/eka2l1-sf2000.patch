             template <typename T>
             void write_string(const std::basic_string<T> &str) {
-                const std::size_t len = str.length();
+                // Fixed-width length. Using sizeof(size_t) here made the file
+                // format depend on the host: a 64-bit desktop wrote 8-byte
+                // lengths while the 32-bit SF2000 port reads 4-byte ones,
+                // desynchronising the stream and turning the next "length" into
+                // garbage (a 1.5GB string resize and std::bad_alloc on device).
+                const std::uint64_t len = str.length();
 
                 write(&len, sizeof(len));
                 write(&str[0], static_cast<std::uint32_t>(len) * sizeof(T));
@@ -80,11 +90,18 @@ namespace eka2l1 {
             template <typename T>
             std::basic_string<T> read_string() {
                 std::basic_string<T> str;
-                std::size_t len;
+                std::uint64_t len;
 
                 read(&len, sizeof(len));
-                str.resize(len);
 
+                // A corrupted or foreign-format file can encode an absurd
+                // length. Do not try to allocate it -- treat the entry as
+                // missing instead of aborting the whole emulator.
+                if ((len > static_cast<std::uint64_t>(0xFFFFFFFF)) || (len > left())) {
+                    return str;
+                }
+
+                str.resize(static_cast<std::size_t>(len));
                 read(&str[0], static_cast<std::uint32_t>(len) * sizeof(T));
 
