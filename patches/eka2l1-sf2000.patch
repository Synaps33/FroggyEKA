diff --git a/CMakeLists.txt b/CMakeLists.txt
index da1f4be..1d809ad 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -3,7 +3,11 @@ cmake_minimum_required(VERSION 3.8)
 project (EKA2L1)
 
 # Clang 14 is required to compile nicely with C++ 20
-set (CMAKE_CXX_STANDARD 20)
+if (SF2000)
+    set(CMAKE_CXX_STANDARD 17)
+else()
+    set(CMAKE_CXX_STANDARD 20)
+endif()
 
 # iOS detection. When building with cmake/ios.toolchain.cmake, CMAKE_SYSTEM_NAME
 # is set to "iOS" before project() runs, so this flag reflects that.
@@ -15,6 +19,24 @@ endif()
 
 set(EKA2L1_IOS_DEPLOYMENT_TARGET "16.0" CACHE STRING "Minimum iOS version to target")
 
+if (SF2000)
+    set(EKA2L1_LIBRETRO ON CACHE BOOL "" FORCE)
+    set(EKA2L1_CPU_DYNCOM_ONLY ON CACHE BOOL "" FORCE)
+    set(EKA2L1_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_ENABLE_SCRIPTING_ABILITY OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_SCRIPTING_LUA OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_BUILD_VULKAN_BACKEND OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_ENABLE_QT_CAMERA OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_BUILD_PATCH OFF CACHE BOOL "" FORCE)
+    set(EKA2L1_ENABLE_DISCORD_RICH_PRESENCE OFF CACHE BOOL "" FORCE)
+endif()
+
+option(EKA2L1_LIBRETRO "Build Libretro core" OFF)
+if (EKA2L1_LIBRETRO AND NOT SF2000)
+    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+endif()
+option(EKA2L1_CPU_DYNCOM_ONLY "Build the CPU module with the dyncom interpreter only (no dynarmic)" OFF)
 option(EKA2L1_BUILD_TOOLS "Build EKA2L1's tool" ON)
 option(EKA2L1_BUILD_TESTS "Build EKA2L1's tests" ON)
 option(EKA2L1_ENABLE_SCRIPTING_ABILITY "Enable to script with Python or Lua" ON)
@@ -167,7 +189,9 @@ else()
     set(ENABLE_DISCORD_RICH_PRESENCE 0)
 endif()
 
-add_subdirectory(src/patch)
+if (NOT SF2000)
+    add_subdirectory(src/patch)
+endif()
 add_subdirectory(src/external)
 add_subdirectory(src/emu)
 
diff --git a/cmake/sf2000.toolchain.cmake b/cmake/sf2000.toolchain.cmake
new file mode 100644
index 0000000..557333a
--- /dev/null
+++ b/cmake/sf2000.toolchain.cmake
@@ -0,0 +1,26 @@
+set(CMAKE_SYSTEM_NAME Generic)
+set(CMAKE_SYSTEM_PROCESSOR mips)
+
+set(SF2000 ON CACHE BOOL "SF2000 target" FORCE)
+set(NO_THREADS ON CACHE BOOL "No threads" FORCE)
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "Static libs" FORCE)
+
+set(MIPS_TOOLCHAIN "/opt/mips32-mti-elf/2019.09-03-2/bin/mips-mti-elf-")
+
+set(CMAKE_C_COMPILER "${MIPS_TOOLCHAIN}gcc")
+set(CMAKE_CXX_COMPILER "${MIPS_TOOLCHAIN}g++")
+set(CMAKE_AR "${MIPS_TOOLCHAIN}ar" CACHE FILEPATH "Archiver" FORCE)
+set(CMAKE_RANLIB "${MIPS_TOOLCHAIN}ranlib" CACHE FILEPATH "Ranlib" FORCE)
+set(CMAKE_OBJCOPY "${MIPS_TOOLCHAIN}objcopy" CACHE FILEPATH "Objcopy" FORCE)
+
+set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+
+set(SF2000_COMMON_FLAGS "-EL -march=mips32 -mtune=mips32 -msoft-float -G0 -mno-abicalls -fno-pic -ffreestanding -fpermissive -DSF2000 -DNO_THREADS -DSPDLOG_NO_TLS=1 -D_GNU_SOURCE -D_GLIBCXX_USE_C99_STDIO=1 -D_GLIBCXX_USE_C99_STDLIB=1 -DFMT_USE_CONSTEXPR=0 -DSPDLOG_NO_TZ_OFFSET -DSPDLOG_NO_THREAD_ID -DRE2_NO_THREADS -DSQLITE_THREADSAFE=0 -DSQLITE_OMIT_LOAD_EXTENSION -DSQLITE_OMIT_WAL=1 -DSQLITE_MAX_MMAP_SIZE=0 -Dlstat=stat -DEKA2L1_CPU_DYNCOM_ONLY_BUILD=1 -ffunction-sections -fdata-sections -isystem /home/Sajnaps/gb300/eka2l1/src/emu/common/include/compat")
+
+set(CMAKE_C_FLAGS "${SF2000_COMMON_FLAGS} -O2" CACHE STRING "" FORCE)
+set(CMAKE_CXX_FLAGS "${SF2000_COMMON_FLAGS} -O2" CACHE STRING "" FORCE)
+
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
