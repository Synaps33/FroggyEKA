+__attribute__((noinline)) void *operator new(std::size_t size) {
+    if (size >= BIG_ALLOC_TRACE_THRESHOLD) {
+        printf("[EKA2L1-TRACE] operator new size=0x%X ra=%p\n", static_cast<unsigned>(size), __builtin_return_address(0));
+    }
