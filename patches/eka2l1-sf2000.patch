     window_group::~window_group() {
+        // `top` is a member unique_ptr, so it is destroyed before the base
+        // window destructor runs. The base destructor walks `child` and writes
+        // child->parent = nullptr; if `child` still points at the canvas that
+        // was just freed, that write lands in freed heap memory and corrupts
+        // the allocator. Detach the canvas while it is still alive.
+        if (top) {
+            if (child == top.get()) {
+                child = top->sibling;
+            }
+
+            top->parent = nullptr;
+            top->sibling = nullptr;
