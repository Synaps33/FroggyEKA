+#elif defined(SF2000)
+
+static void* plutovg_mmap(const char* filename, long* length)
+{
+    FILE* f = fopen(filename, "rb");
+    if(!f)
+        return NULL;
+    fseek(f, 0, SEEK_END);
+    long size = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if(size <= 0) {
+        fclose(f);
+        return NULL;
+    }
+    void* data = malloc(size);
+    if(!data) {
+        fclose(f);
+        return NULL;
+    }
+    fread(data, 1, size, f);
+    fclose(f);
+    *length = size;
+    return data;
+}
+
+static void plutovg_unmap(void* data, long length)
+{
+    free(data);
+}
+
 #else
 
